public class Boompanes {

public class Main2 {
    
    public static void main(String[] args) {


    
        Scanner input = new Scanner(System.in);


        // Ignore parentheses, commas, and spaces (keeps '-' for negative values)
        input.useDelimiter("[^0-9-]+");


        // Read two numbers from tuple input, e.g., (98,89)
        int a = input.nextInt();
        int b = input.nextInt();


        int result = gcd(a, b);


        // Validate input and print result
        if (a < 0 || b < 0) {
            System.out.print("Invalid Input.");


        } else if (a == 0 && b == 0) {
            System.out.println("Undefined - handle in main()");


        } else {
            System.out.println(result);
        }


        input.close();
    }


    // Computes GCD recursively using the Euclidean algorithm
    public static int gcd(int a, int b) {
        if (b == 0) {
            return a;
        }
        return gcd(b, a % b);
    }


}
}